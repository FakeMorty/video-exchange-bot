# ============================
# Обязательные
# ============================
BOT_TOKEN=123456:ABC-DEF
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
ADMINS=123456789
WEBHOOK_BASE=https://your-app.onrender.com
WEBHOOK_PATH=/webhook
PROVIDER_TOKEN=your_provider_token
BOT_USERNAME=your_bot_username
LOG_CHAT_ID=-1001234567890

# ============================
# ИИ-ассистент (Катя)
# ============================
ENABLE_AI_ASSISTANT=true
AI_ASSISTANT_API_KEY=om-your-key-here
AI_ASSISTANT_BASE_URL=https://api.openmodel.ai
AI_ASSISTANT_MODEL=deepseek-v4-flash
AI_ASSISTANT_MAX_TOKENS=2048
AI_ASSISTANT_COOLDOWN_SEC=5
AI_ASSISTANT_HISTORY_LIMIT=10
AI_ASSISTANT_DAILY_LIMIT=50
AI_ASSISTANT_PRICE=5
