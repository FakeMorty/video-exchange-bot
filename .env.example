# ============================
# Обязательные
# ============================
BOT_TOKEN=123456:ABC-DEF
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
ADMINS=123456789
WEBHOOK_BASE=https://your-app.onrender.com
WEBHOOK_PATH=/webhook
PROVIDER_TOKEN=your_provider_token
BOT_USERNAME=your_bot_username
LOG_CHAT_ID=-1001234567890

# ============================
# 🚀 Космическая аркада (Mini App на /arcade)
# Все параметры также меняются из админки (⚙️ Настройки бота → 🚀 Аркада).
# ============================
ENABLE_ARCADE=true
ARCADE_MIN_BET=10
ARCADE_MAX_BET=250
ARCADE_MAX_MULTIPLIER=50
ARCADE_DAILY_PROFIT_CAP=500
ARCADE_RUN_TTL_MINUTES=30

# ============================
# DonationAlerts: автоматическая сверка платежей
# Создайте OAuth-приложение в DonationAlerts и задайте секреты только в
# Environment Variables хостинга. Не добавляйте реальные значения в Git.
# Для полной автоматики нужны CLIENT_ID, CLIENT_SECRET и REFRESH_TOKEN.
# ACCESS_TOKEN — ограниченный резерв для уже выданного OAuth access token.
# ============================
DONATION_ALERTS_URL=https://dalink.to/your-page
DONATION_ALERTS_CLIENT_ID=
DONATION_ALERTS_CLIENT_SECRET=
DONATION_ALERTS_REFRESH_TOKEN=
DONATION_ALERTS_ACCESS_TOKEN=
DONATION_ALERTS_SYNC_INTERVAL_SECONDS=60
DONATION_ALERTS_ORDER_TTL_MINUTES=120
# Должен совпасть с Redirect URI в приложении DonationAlerts.
DONATION_ALERTS_OAUTH_REDIRECT_URI=https://your-app.onrender.com/donationalerts/oauth/callback
# Сгенерируйте длинную случайную строку и храните только в Environment Variables.
DONATION_ALERTS_OAUTH_STATE=
