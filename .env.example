# ============================
# Обязательные
# ============================
BOT_TOKEN=123456:ABC-DEF
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
ADMINS=123456789
WEBHOOK_BASE=https://your-app.onrender.com
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=
VERCEL_RELEASE_WEBHOOK_SECRET=
PROVIDER_TOKEN=your_provider_token
BOT_USERNAME=your_bot_username
LOG_CHAT_ID=-1001234567890

# ============================
# 🚀 Космическая аркада (Mini App на /arcade)
# Все параметры также меняются из админки (⚙️ Настройки бота → 🚀 Аркада).
# ============================
ENABLE_ARCADE=true
ARCADE_MIN_BET=10
ARCADE_MAX_BET=250
ARCADE_MAX_MULTIPLIER=50
ARCADE_DAILY_PROFIT_CAP=500
ARCADE_RUN_TTL_MINUTES=30

# ============================
# Оплата переводом на карту (Т-Банк): ручная сверка админом.
# Пользователь переводит точную сумму по ссылке и обязательно указывает
# в комментарии свой юзернейм в Telegram; админ проверяет перевод и
# начисляет монеты/VIP через конвертер в админке («💳 Платежи»).
# ============================
CARD_PAYMENT_URL=https://www.tbank-online.com/rm/r_ZAVxbmCrOP.IZpYpwbnlB/CRDOu48229
RUB_TO_COINS_RATE=10.0
VIP_PRICE_RUB=150.0

# Ежедневный бонус: runtime-настройки БД имеют приоритет над этими значениями.
DAILY_BONUS_STREAK_BASE=5
DAILY_BONUS_STREAK_INCREASE=1
# Потолок — верх прогрессии в последний день 30-дневной серии (5 + 29×1 = 34).
# Ниже значения серия 30 дней закрывается на более раннем дне.
DAILY_BONUS_CAP=34
