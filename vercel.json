{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{app/banner*.jpg,постеры/**,banners/**}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index?__vercel_path=/$1" }
  ]
}
